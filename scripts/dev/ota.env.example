# 复制到 ~/.crab_feast-ota/ota.env，然后 chmod 600 该文件。
# 这个文件是唯一配置点：ota_serve.sh / ota_publish.sh / SSH 强制命令 / cron 都会读它，
# 交互 shell 里的 export 传不到这些场景（尤其 SSH 强制命令只跑一条命令，不读 .zshrc）。

# ---- 必填 ----
# 手机能解析到的域名。推荐自有域名 + DNSPod 免费解析（DuckDNS 注册要过 Google 验证码，国内打不开）
OTA_HOST=ota.example.top

# dnspod | alidns | cloudflare | duckdns
OTA_DNS_PROVIDER=dnspod

# ---- 凭据（按 provider 只填一组）----
# DNSPod：控制台 → API 密钥 → 新建（必须选 "DNSPod Token"，不是腾讯云 API 密钥）
DP_LOGIN_TOKEN=123456,abcdef0123456789
# CF_API_TOKEN=
# ALI_ACCESS_KEY_ID=
# ALI_ACCESS_KEY_SECRET=
# DUCKDNS_TOKEN=

# dnspod / alidns 必填主域名；cloudflare 可留空（自动找 zone）
OTA_DNS_ZONE=example.top

# ---- 可选 ----
# OTA_HTTPS_PORT=8443
# OTA_IFACE=en1          # 走 Wi-Fi；有线改 en0
# OTA_MODE=ipv6          # 有 OTA_HOST 时默认就是 ipv6；想回 tailscale 就填 serve
